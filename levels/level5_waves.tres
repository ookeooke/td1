; ============================================================================
; Level 5 — Riverford. Two paths, both crossing the plank bridge:
;   bl_plank — main path (BL spawn). Active every wave.
;   tl_plank — second path (TL spawn). Activates from W3 onward.
;
; Wave structure: W1–W2 are a single-front warm-up on bl_plank; W3 opens
; the second front as an escalation moment. W3–W10 use both paths.
;
; 10-wave campaign at target_ppt = 6 (~17,600 hardness).
; ============================================================================

; ---- Wave 1: warm-up — main path only, basics + a small armor closer ----
[sub_resource type="Resource" id="L5_W1_BLBasic"]
script = ExtResource("3_spawn")
path_id = "bl_plank"
enemy_scene = ExtResource("4_basic")
count = 10
interval = 5.0

[sub_resource type="Resource" id="L5_W1_BLArmor"]
script = ExtResource("3_spawn")
path_id = "bl_plank"
enemy_scene = ExtResource("6_armor")
count = 3
interval = 14.0
start_delay = 16.0

[sub_resource type="Resource" id="L5_Wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("L5_W1_BLBasic"), SubResource("L5_W1_BLArmor")])
countdown = 0.0
bounty = 85

