; ============================================================================
; Level 1 — interleaved staggered emitters per wave so the merged spawn
; timeline is continuous (max_gap ≤ 5s). Type variety within each wave
; (basics + flying + armored simultaneously instead of sequential bursts).
; W1 is button-only (countdown=0); W2-W5 use bounded countdowns with
; 10s send-wave window. Gold targets [70, 77, 112, 161, 280] = 700g total.
; See balance/BALANCE.md "Authored economy + pressure curve".
; ============================================================================

; ---- Wave 1: tutorial — single path, basics only, continuous ----

[sub_resource type="Resource" id="Spawn_W1_Basic"]
script = ExtResource("3_spawn")
enemy_scene = ExtResource("4_basic")
count = 8
interval = 4.0

[sub_resource type="Resource" id="Wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("Spawn_W1_Basic")])
countdown = 0.0
bounty = 60

; ---- Wave 2: 2 paths interleaved + healer at end (introduces priority target) ----

[sub_resource type="Resource" id="Spawn_W2_BasicL"]
script = ExtResource("3_spawn")
enemy_scene = ExtResource("4_basic")
count = 7
interval = 5.0

[sub_resource type="Resource" id="Spawn_W2_BasicR"]
script = ExtResource("3_spawn")
path_id = "right"
enemy_scene = ExtResource("4_basic")
count = 5
interval = 5.0
start_delay = 2.5

[sub_resource type="Resource" id="Spawn_W2_Healer"]
script = ExtResource("3_spawn")
enemy_scene = ExtResource("6_heal")
start_delay = 27.0

[sub_resource type="Resource" id="Wave2"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("Spawn_W2_BasicL"), SubResource("Spawn_W2_BasicR"), SubResource("Spawn_W2_Healer")])
countdown = 20.0
bounty = 40

; ---- Wave 3: 3 paths + flying + armored (introduces magic-vs-armor decision) ----

