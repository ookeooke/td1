[sub_resource type="Resource" id="MageRegen"]
script = ExtResource("6_regen")
ability_id = "mage_meditation"
trigger = 1
interval = 3.0

[sub_resource type="Resource" id="Talent_Meditation"]
script = ExtResource("5_talent")
talent_id = "mage_meditation"
talent_name = "Meditation"
description = "Passively regenerate 3 HP every 3 seconds."
star_cost = 2
ability = SubResource("MageRegen")

[sub_resource type="Resource" id="MageLifesteal"]
script = ExtResource("7_lifesteal")
heal_amount = 3.0
ability_id = "mage_siphon"
trigger = 3

[sub_resource type="Resource" id="Talent_Siphon"]
script = ExtResource("5_talent")
talent_id = "mage_siphon"
talent_name = "Arcane Siphon"
description = "Each attack heals the Mage for 3 HP."
star_cost = 3
prerequisite_id = "mage_meditation"
ability = SubResource("MageLifesteal")

[sub_resource type="Resource" id="MageBonusDmg"]
script = ExtResource("8_bonusdmg")
bonus_damage = 5.0
bonus_damage_type = 1
ability_id = "mage_power"
trigger = 3

[sub_resource type="Resource" id="Talent_ArcanePower"]
script = ExtResource("5_talent")
talent_id = "mage_arcane_power"
talent_name = "Arcane Power"
description = "+5 bonus magic damage on every attack."
star_cost = 3
ability = SubResource("MageBonusDmg")

[resource]
script = ExtResource("1_data")
hero_name = "Mage"
hero_id = "hero_mage"
requires_unlock = true
max_health = 40
attack_damage = 1.0
attack_range = 320.0
engage_radius = 45.0
attack_speed = 0.6
move_speed = 180.0
armor = 0.0
magic_resist = 0.4
damage_type = 1
respawn_time = 35.0
max_block_targets = 1
detection_radius_px = 100.0
close_attack_damage = 0.5
close_attack_speed = 0.7
close_attack_damage_type = 0
guard_back_px = 70.0
skills = Array[Resource]([ExtResource("2_fireball"), ExtResource("4_shield"), ExtResource("13_nova"), ExtResource("14_meteor")])
starter_skill_ids = Array[String](["fireball", "mana_shield"])
talents = Array[Resource]([SubResource("Talent_Meditation"), SubResource("Talent_Siphon"), SubResource("Talent_ArcanePower")])
visual = ExtResource("9_vis")
projectile_scene = ExtResource("15_bolt")
starter_items = Array[Resource]([ExtResource("10_s_sword"), ExtResource("11_s_tunic"), ExtResource("12_s_charm")])
encyclopedia_entry = "Fragile ranged caster. High magic damage, crowd control, and self-sustain. Keep away from melee."
