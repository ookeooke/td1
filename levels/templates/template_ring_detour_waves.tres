; ============================================================================
; Template placeholder waves — single wave of basic enemies on path "main"
; (the ring path). Replace with authored content when generating a real level.
; ============================================================================

[sub_resource type="Resource" id="W1_Basic"]
script = ExtResource("3_spawn")
path_id = "main"
enemy_scene = ExtResource("4_basic")
count = 8
interval = 2.5

[sub_resource type="Resource" id="Wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("W1_Basic")])
countdown = 0.0
bounty = 50

[resource]
script = ExtResource("1_list")
waves = Array[ExtResource("2_wave")]([SubResource("Wave1")])
