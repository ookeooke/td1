enemy_scene = ExtResource("6_armor")
count = 5
interval = 7.0
start_delay = 6.0

[sub_resource type="Resource" id="L3_Wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("L3_W1_BasicA"), SubResource("L3_W1_BasicB"), SubResource("L3_W1_Armor")])
countdown = 0.0
bounty = 80

