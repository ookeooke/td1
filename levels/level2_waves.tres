; ============================================================================
; Level 2 — Single-path serpentine. target_ppt=3, target hardness ~9,000.
; All spawns funnel through path_id="main" — one entry, one exit, lots of curves.
; ============================================================================

[sub_resource type="Resource" id="L2_W1_Basic"]
script = ExtResource("3_spawn")
path_id = "main"
enemy_scene = ExtResource("4_basic")
count = 12
interval = 3.5

[sub_resource type="Resource" id="L2_W1_Armor"]
script = ExtResource("3_spawn")
path_id = "main"
enemy_scene = ExtResource("6_armor")
