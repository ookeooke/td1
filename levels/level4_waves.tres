; ============================================================================
; Level 4 — STUB FOR BALANCE TESTING. target_ppt=5 (expected ~15,000) but
; INTENTIONALLY UNDER-TUNED to ~13,500. Exercises the audit's yellow drift
; coloring (-15..-25%). Use as the "this level is too easy, beef it up" demo.
; ============================================================================

[sub_resource type="Resource" id="L4_W1_BasicL"]
script = ExtResource("3_spawn")
enemy_scene = ExtResource("4_basic")
count = 12
interval = 3.5

[sub_resource type="Resource" id="L4_W1_BasicR"]
script = ExtResource("3_spawn")
path_id = "right"
enemy_scene = ExtResource("4_basic")
count = 10
interval = 4.0
start_delay = 2.0

