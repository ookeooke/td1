; ============================================================================
; Level 3 — Mountain Pass (ring detour). target_ppt=4 (expected ~12,000) but
; INTENTIONALLY OVER-TUNED to ~16,000 — exercises the audit's red drift
; coloring (>+25%) as the "this level is too hard, retune it" demo.
; All spawns funnel through path_id = "main" (the single ring path).
; ============================================================================

[sub_resource type="Resource" id="L3_W1_BasicA"]
script = ExtResource("3_spawn")
path_id = "main"
enemy_scene = ExtResource("4_basic")
count = 14
interval = 3.0

[sub_resource type="Resource" id="L3_W1_BasicB"]
script = ExtResource("3_spawn")
path_id = "main"
enemy_scene = ExtResource("4_basic")
