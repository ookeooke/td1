[gd_resource type="Resource" script_class="HeroData" format=3]

[ext_resource type="Script" path="res://heroes/HeroData.gd" id="1_data"]
[ext_resource type="Resource" path="res://heroes/data/skills/skill_summon_soldiers.tres" id="2_summon"]
[ext_resource type="Resource" path="res://heroes/data/skills/skill_bless.tres" id="3_bless"]
[ext_resource type="Resource" path="res://heroes/data/skills/skill_shield_bash.tres" id="4_bash"]
[ext_resource type="Script" path="res://progression/TalentData.gd" id="5_talent"]
[ext_resource type="Script" path="res://systems/abilities/LifestealAbility.gd" id="6_lifesteal"]
[ext_resource type="Script" path="res://systems/abilities/OnHitBonusDamageAbility.gd" id="7_bonusdmg"]
[ext_resource type="Script" path="res://systems/abilities/RegenAbility.gd" id="8_regen"]
[ext_resource type="Resource" path="res://heroes/data/visual_warrior.tres" id="9_vis"]
[ext_resource type="Resource" path="res://items/bases/base_starter_sword.tres" id="10_s_sword"]
[ext_resource type="Resource" path="res://items/bases/base_starter_tunic.tres" id="11_s_tunic"]
[ext_resource type="Resource" path="res://items/bases/base_starter_charm.tres" id="12_s_charm"]
[ext_resource type="Resource" path="res://heroes/data/skills/skill_rally_cry.tres" id="13_rally"]

[sub_resource type="Resource" id="Regen_Ability"]
script = ExtResource("8_regen")
heal_amount = 2.0
ability_id = "warrior_endurance"
trigger = 1
interval = 2.0

[sub_resource type="Resource" id="Talent_Endurance"]
script = ExtResource("5_talent")
talent_id = "warrior_endurance"
talent_name = "Endurance"
description = "Passively regenerate 2 HP every 2 seconds."
star_cost = 2
ability = SubResource("Regen_Ability")

[sub_resource type="Resource" id="Lifesteal_Ability"]
script = ExtResource("6_lifesteal")
ability_id = "warrior_lifesteal"
trigger = 3

[sub_resource type="Resource" id="Talent_Vampiric"]
script = ExtResource("5_talent")
talent_id = "warrior_vampiric"
talent_name = "Vampiric Strike"
description = "Each attack heals the Knight for 2 HP."
star_cost = 2
ability = SubResource("Lifesteal_Ability")

[sub_resource type="Resource" id="BonusDmg_Ability"]
script = ExtResource("7_bonusdmg")
bonus_damage = 4.0
ability_id = "warrior_heavy_blows"
trigger = 3

[sub_resource type="Resource" id="Talent_HeavyBlows"]
script = ExtResource("5_talent")
talent_id = "warrior_heavy_blows"
talent_name = "Heavy Blows"
description = "+4 bonus physical damage on every attack."
star_cost = 3
prerequisite_id = "warrior_vampiric"
ability = SubResource("BonusDmg_Ability")

[resource]
script = ExtResource("1_data")
hero_name = "Knight"
hero_id = "hero_warrior"
max_health = 60
attack_damage = 1.75
attack_range = 75.0
move_speed = 220.0
armor = 0.25
skills = Array[Resource]([ExtResource("2_summon"), ExtResource("3_bless"), ExtResource("4_bash"), ExtResource("13_rally")])
talents = Array[Resource]([SubResource("Talent_Endurance"), SubResource("Talent_Vampiric"), SubResource("Talent_HeavyBlows")])
visual = ExtResource("9_vis")
starter_items = Array[Resource]([ExtResource("10_s_sword"), ExtResource("11_s_tunic"), ExtResource("12_s_charm")])
encyclopedia_entry = "Sword-and-board melee hero. Strong armor, tanks ground enemies. Hits flying foes when in range."
